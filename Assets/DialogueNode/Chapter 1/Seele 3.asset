  defaultSpeakerName: 
  defaultSpeakerPortrait: {fileID: 0}
  lines:
  - speakerName: Seele
    text: "V\xEC sao ng\u01B0\u01A1i l\u1EA1i \u0111\u1EBFn n\u01A1i n\xE0y?"
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "T\xF4i b\u1ED7ng nhi\xEAn b\u1ECB d\u1ECBch chuy\u1EC3n \u0111\u1EBFn
      \u0111\xE2y."
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "Ng\u1EABu nhi\xEAn \u01B0?? Ng\u01B0\u01A1i \u0111\xE3 \u0111\u1EBFn d\xE2y
      r\u1EA5t nhi\u1EC1u l\u1EA7n, ng\u01B0oi g\xE2y r\u1ED1i \u0111\u1EBFn \"Souls
      World\" v\xE0 g\xE2y \u1EA3nh h\u01B0\u1EDFng t\u1EDBi c\xE1c linh h\u1ED3n
      kh\xE1c."
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "T\xF4i kh\xF4ng c\xF3 m\xE0!!"
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "Sybau, con ng\u01B0\u1EDDi gi\u1EA3 d\u1ED1i c\xE1c ng\u01B0\u01A1i \u0111\u1EBFn
      \u0111\xE2y v\u1EDBi m\u1EE5c \u0111\xEDch g\xEC??"
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: .....
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "Tr\u1EA3 l\u1EDDi \u0111i."
    portrait: {fileID: 0}
