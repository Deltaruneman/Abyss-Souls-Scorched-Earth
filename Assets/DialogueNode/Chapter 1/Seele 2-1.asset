  m_Script: {fileID: 11500000, guid: 6aee07975a450b445a8cb8f743cb0138, type: 3}
  m_Name: Seele 2-1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  defaultSpeakerName: 
  defaultSpeakerPortrait: {fileID: 0}
  lines:
  - speakerName: "Tr\u1ECDng"
    text: "Khoan \u0111\xE3 c\xF3 chuy\u1EC7n g\xEC c\u01A1??"
    portrait: {fileID: 8450617891289647664, guid: 0787d78164ac3f84c95b6a63ef5387c6, type: 3}
  - speakerName: 'Seele '
    text: "\u0110\u1EEBng gi\u1EA3 v\u1EDD n\u1EEFa"
    portrait: {fileID: 2409566010381075323, guid: 4a8b1aa6d68084f48ae2656d9ce9724c, type: 3}
  - speakerName: 'Seele '
    text: "Ta bi\u1EBFt ng\u01B0\u01A1i ch\xEDnh l\xE0 k\u1EBB \u0111\xF3."
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng "
    text: "Ch\u1EDD \u0111\xE3 n\xE0o, t\xF4i kh\xF4ng hi\u1EC3u c\xF4 mu\u1ED1n
      n\xF3i g\xEC c\u1EA3?!?"
    portrait: {fileID: -3637415787416595814, guid: c11520c809d13a843b51ec0a0ae15cf4, type: 3}
  - speakerName: Seele
    text: "Ng\u01B0\u01A1i ch\xEDnh l\xE0 k\u1EBB \u0111\xE3 \u0111\u1EBFn\" Souls
      World\" m\u1EA5y h\xF4m nay"
    portrait: {fileID: 2409566010381075323, guid: 4a8b1aa6d68084f48ae2656d9ce9724c, type: 3}
  - speakerName: "Tr\u1ECDng "
    text: "Khoan \u0111\xE3, c\xE1i g\xEC c\u01A1??"
    portrait: {fileID: -3637415787416595814, guid: c11520c809d13a843b51ec0a0ae15cf4, type: 3}
  - speakerName: Seele
    text: "Ranh gi\u1EDBi c\u1EE7a ng\u01B0\u1EDDi ch\u1EBFt v\xE0 k\u1EBB s\u1ED1ng
      l\xE0 kh\xF4ng th\u1EC3 x\xE2m ph\u1EA1m"
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "?!?? ( C\xF4 ta \u0111ang n\xF3i g\xEC v\u1EADy, m\xECnh ch\u1EB3ng hi\u1EC3u
      g\xEC c\u1EA3)"
    portrait: {fileID: 4586876698041690954, guid: 8196b28ed0d17a247a6872d53ec51d53, type: 3}
  - speakerName: Seele
    text: "Ta s\u1EBD \u0111\u1EABn ng\u01B0\u01A1i \u0111i x\xE9t s\u1EED."
    portrait: {fileID: -6885905248504999547, guid: 24ae113b913d8fd49b0c919264359eba, type: 3}
  choices: []
  autoContinueNode: {fileID: 0}
  onEnter:
    m_PersistentCalls:
      m_Calls: []
