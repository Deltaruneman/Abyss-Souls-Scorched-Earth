--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6aee07975a450b445a8cb8f743cb0138, type: 3}
  m_Name: Seele 5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  defaultSpeakerName: 
  defaultSpeakerPortrait: {fileID: 0}
  lines:
  - speakerName: Seele
    text: "N\xE0y nhanh l\xEAn \u0111i ch\u1EE9."
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "T\xF4i kh\xF4ng th\u1EC3 bay nh\u01B0 c\xF4 \u0111\xE2u."
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "(m\xE0 ngh\u0129 l\u1EA1i th\xEC v\xEC sao c\xF4 ta l\u1EA1i mang h\xECnh
      d\u1EA1ng nh\u01B0 n\xE0y nh\u1EC9)"
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "(ngh\u0129 k\u1EF9 l\u1EA1i th\xEC v\xEC sao m\xECnh kh\xF4ng c\u1EA3m
      th\u1EA5y s\u1EE3 v\u1EDBi 1 sinh v\u1EADt nh\u01B0 v\u1EADy nh\u1EC9??)"
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "(m\xE0 \u1EDF c\xE1i n\u01A1i k\xEC l\u1EA1i n\xE0y th\xEC c\xF2n chuy\u1EC7n
      g\xEC t\u1EC7 h\u01A1n x\u1EA3y ra \u0111\u01B0\u1EE3c n\u1EEFa nh\u1EC9?)"
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "Ban \u0111\u1EA7u ta c\u0169ng t\u1EEBng c\xF3 c\u01A1 th\u1EC3 nh\u01B0
      ng\u01B0\u1EDDi v\u1EADy"
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "?!?! \xDD c\xF4 l\xE0 sao c\u01A1.?"
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "D\u01B0\u1EDBi \u1EA3nh h\u01B0\u1EDFng c\u1EE7a \"Souls World\" c\u01A1
      th\u1EC3 b\u1ECDn ta kh\xF4ng c\xF2n gi\u1EEF \u0111\u01B0\u1EE3c c\u1EA5u
      tr\xFAc v\u1ED1n c\xF3."
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "Gi\u1EDD ta ch\u1EC9 c\xF2n linh h\u1ED3n v\xE0 ma l\u1EF1c th\xF4i."
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "D\u0129 nhi\xEAn s\u1EED d\u1EE5ng ma l\u1EF1c s\u1EBD khi\u1EBFn linh
      h\u1ED3n ta y\u1EBFu \u0111i."
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "\u0110\xF3 l\xE0 l\xED do ta kh\xF4ng gi\u1EBFt ng\u01B0\u01A1i ngay t\u1EEB
      \u0111\u1EA7u \u0111\u1EA5y."
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "Ch\u1EDD \u0111\xE3 n\xE0o..."
    portrait: {fileID: 0}
  choices:
  - choiceText: "H\u1ECFi qu\xE1 kh\u1EE9"
    nextNode: {fileID: 11400000, guid: 1c66aa9a3926c8849854e36fd00ed5bc, type: 2}
  - choiceText: ...
    nextNode: {fileID: 0}
  autoContinueNode: {fileID: 0}
  onEnter:
    m_PersistentCalls:
      m_Calls: []
