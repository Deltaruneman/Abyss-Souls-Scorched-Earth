  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6aee07975a450b445a8cb8f743cb0138, type: 3}
  m_Name: Seele 5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  defaultSpeakerName: 
  defaultSpeakerPortrait: {fileID: 0}
  lines:
  - speakerName: Seele
    text: "N\xE0y nhanh l\xEAn \u0111i ch\u1EE9."
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "(m\xE0 ngh\u0129 l\u1EA1i th\xEC v\xEC sao c\xF4 ta l\u1EA1i mang h\xECnh
      d\u1EA1ng nh\u01B0 n\xE0y nh\u1EC9)"
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "(ngh\u0129 k\u1EF9 l\u1EA1i th\xEC v\xEC sao m\xECnh kh\xF4ng c\u1EA3m
      th\u1EA5y s\u1EE3 v\u1EDBi 1 sinh v\u1EADt nh\u01B0 v\u1EADy nh\u1EC9??)"
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "(m\xE0 \u1EDF c\xE1i n\u01A1i k\xEC l\u1EA1i n\xE0y th\xEC c\xF2n chuy\u1EC7n
      g\xEC t\u1EC7 h\u01A1n x\u1EA3y ra \u0111\u01B0\u1EE3c n\u1EEFa nh\u1EC9?)"
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "N\xE0y b\u1EDBt suy ngh\u0129 trong \u0111\u1EA7u l\u1EA1i m\xE0 \u0111i
      ti\u1EBFp \u0111i"
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng "
    text: "Sao c\xF4 ta bi\u1EBFt \u0111\u01B0\u1EE3c..."
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "\u0110ang t\xF2 m\xF2 v\xEC sao ta bi\u1EBFt \u0111\xFAng kh\xF4ng :))"
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "Ta c\xF3 th\u1EC3 c\u1EA3m nh\u1EADn \u0111\u01B0\u1EE3c qua ma l\u1EF1c."
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "Tuy kh\xF4ng th\u1EC3 bi\u1EBFt ng\u01B0\u01A1i \u0111ang ngh\u0129 g\xEC
      nh\u01B0ng c\xF3 th\u1EC3 c\u1EA3m nh\u1EADn ng\u01B0\u01A1i \u0111ang ngh\u0129."
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "Gi\u1ED1ng nh\u01B0 c\u1EA3m nh\u1EADn \u0111\u01B0\u1EE3c ma l\u1EF1c
      \u01B0"
    portrait: {fileID: 0}
  - speakerName: Seele
    text: "\u1EEA ki\u1EC3u v\u1EADy.... Khoan sao ng\u01B0\u01A1i bi\u1EBFt"
    portrait: {fileID: 0}
  - speakerName: "Tr\u1ECDng"
    text: "\u0110o\xE1n b\u1EEBa th\xF4i."
    portrait: {fileID: 0}
  choices:
  - choiceText: "L\xE0m \u01A1n cho t\xF4i tho\xE1t kh\u1ECFi \u0111\xE2y!"
    nextNode: {fileID: 11400000, guid: 1c66aa9a3926c8849854e36fd00ed5bc, type: 2}
  - choiceText: ...
    nextNode: {fileID: 0}
  autoContinueNode: {fileID: 0}
  onEnter:
    m_PersistentCalls:
      m_Calls: []
